pipeline {
    agent any

    tools {
        jdk 'java 21'
        maven 'maven3.9'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('patient-service') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('patient-service') {
                    sh 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('patient-service') {
                    sh 'mvn package -DskipTests'
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true,
                  testResults: 'patient-service/target/surefire-reports/*.xml'
        }

        success {
            echo 'Patient Service CI completed successfully!'
        }

        failure {
            echo 'Patient Service CI failed. Check the console output.'
        }
    }
}